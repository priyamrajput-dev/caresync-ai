# ============================================================
# CareSync AI — Node.js / Express MERN Backend Environment
# Copy this file to .env and configure your parameters.
# NEVER commit .env to version control.
# ============================================================

# Environment & Server
NODE_ENV=development
PORT=8000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# MongoDB & MongoDB Atlas
# For local development:
MONGO_URL=mongodb://localhost:27017
MONGO_DB=caresync

# For MongoDB Atlas Vector Search:
# MONGO_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net
# MONGO_DB=caresync
ATLAS_VECTOR_INDEX_NAME=vector_index
EMBEDDING_DIMENSION=1536

# JWT Authentication
JWT_SECRET=your-secure-jwt-secret-key-min-32-chars-hex
JWT_EXPIRES_IN=24h

# Anthropic Claude AI
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
